# Copy this file to .env and fill in your values. Never commit .env.

# Amazon Bedrock answer model. Create a Bedrock API key in the AWS console (Bedrock > API keys), paste it here and keep
# it out of git. Without a key the bot answers from its written template answers only.
AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_REGION=ap-south-1
# BEDROCK_MODEL_ID=google.gemma-3-27b-it

# Second safety layer (needs the Bedrock key above): a short model call that can raise the emergency or self-harm reply
# when the word rules find nothing. It only adds alarms and never cancels a rule. Set to false to switch it off.
# SAFETY_LLM_CHECK=true
# SAFETY_LLM_TIMEOUT_S=2.5
# A different model for the check, for example openai.gpt-oss-20b-1:0 (then also set SAFETY_LLM_MAX_TOKENS=900).
# SAFETY_LLM_MODEL_ID=

# Fact-checking compares a claim with a curated list of Indian health myths first; for unknown claims it searches the
# web for evidence from health authorities and fact-checkers and asks the model for a verdict (v1 behaviour; v2 will
# use the official document library instead).

# Browser origins allowed to call the API (comma separated). The page itself is served from the same origin.
# CORS_ORIGINS=https://aarogyasathi.nova-care.xyz,http://localhost:8000
# Messages one client address may send to /api/chat per minute (0 = no limit). Default 30.
# RATE_LIMIT_PER_MIN=30

# Optional WhatsApp channel (Meta Cloud API). Off unless WHATSAPP_ENABLED=true. Never commit real values.
# WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
# Secret for the WhatsApp test route (/webhook/whatsapp/simulate). Leave blank to disable that route.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
